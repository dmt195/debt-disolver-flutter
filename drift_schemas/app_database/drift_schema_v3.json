        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"scenarios\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"monthly_budget_minor\" INTEGER NOT NULL, \"consolidation_apr_bps\" INTEGER NOT NULL, \"consolidation_term_months\" INTEGER NOT NULL, \"consolidation_fee_bps\" INTEGER NOT NULL, \"transfer_fee_bps\" INTEGER NOT NULL, \"promo_months\" INTEGER NOT NULL, \"revert_apr_bps\" INTEGER NOT NULL, \"transfer_credit_limit_minor\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
