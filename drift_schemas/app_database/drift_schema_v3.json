      "name": "debts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"debts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"balance_minor\" INTEGER NOT NULL, \"apr_bps\" INTEGER NOT NULL, \"min_payment_percent_bps\" INTEGER NOT NULL, \"min_payment_floor_minor\" INTEGER NOT NULL, \"allows_overpayment\" INTEGER NOT NULL CHECK (\"allows_overpayment\" IN (0, 1)), \"promo_apr_bps\" INTEGER NULL, \"promo_ends_year_month\" INTEGER NULL, \"offer_fee_bps\" INTEGER NULL, \"offer_promo_apr_bps\" INTEGER NULL, \"offer_promo_months\" INTEGER NULL, \"offer_available_credit_minor\" INTEGER NULL, \"sort_index\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
