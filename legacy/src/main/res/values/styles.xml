<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppBaseTheme" parent="android:Theme.Light">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
    </style>

    <style name="smallWhiteText">
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@android:color/background_light</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

    </style>

    <style name="table_entry">
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:background">@android:color/background_light</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
    </style>


    <style name="list_text">
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/primary_text_dark</item>
        <item name="android:padding">8dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="analysis_highlight_text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">50dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#d35400</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="analysis_detail_text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">#c0392b</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="card_style">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_below">@+id/imageView</item>
        <item name="android:layout_alignLeft">@+id/tv_title</item>
        <item name="android:background">@drawable/rect3783</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginRight">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

</resources>
